#version 460
#extension GL_GOOGLE_include_directive : require

#include "types.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) readonly uniform image2D albedo;
layout(set = 0, binding = 1, rgba16f) readonly uniform image2D normals;
layout(set = 0, binding = 2, r8) readonly uniform image2D shadows;
layout(set = 0, binding = 3, rgba32f) readonly uniform image2D hit_pos;

layout(set = 1, binding = 0) uniform sampler3D lightMap;

layout(set = 2, binding = 0, rgba32ui) readonly uniform uimage3D voxelImage;

layout(set = 3, binding = 0, rgba8) writeonly uniform image2D outputImage;

layout(push_constant) uniform Parameters {
    GlobalLight sun;
    ivec3 lightVolumeMin;
    vec3 volumeSize;
    float localStrength;
    float aoStrength;
    vec3 skyColor;
} params;

#include "common.glsl"

float vertexAO(bool tanSideSolid, bool biTanSideSolid, bool cornerSolid) {
    if (tanSideSolid && biTanSideSolid) return 0.0;
    return (3.0 - float(tanSideSolid) - float(biTanSideSolid) - float(cornerSolid)) / 3.0;
}

float voxelAO(vec3 position, vec3 normal) {
    vec3 absNormal = abs(normal);
    int faceAxis = (absNormal.x > absNormal.y) ? ((absNormal.x > absNormal.z) ? 0 : 2) : ((absNormal.y > absNormal.z) ? 1 : 2);

    ivec3 faceNormalOffset = ivec3(0);
    faceNormalOffset[faceAxis] = (normal[faceAxis] > 0.0) ? 1 : -1;

    int tanAxis = (faceAxis + 1) % 3;
    int biTanAxis = (faceAxis + 2) % 3;
    
    ivec3 tanStep  = ivec3(0);
    ivec3 biTanStep = ivec3(0);

    tanStep[tanAxis] = 1;
    biTanStep[biTanAxis] = 1;

    ivec3 airVoxel = ivec3(floor(position + vec3(faceNormalOffset) * 0.5));

    float tanFrac = fract(position[tanAxis]);
    float biTanFrac = fract(position[biTanAxis]);

    float cornerAO[4];

	ivec3 texel_coord = ivec3(-1);
    uvec4 texel       = uvec4(0);

    for (int cornerRow = 0; cornerRow < 2; cornerRow++)
        for (int cornerColumn = 0; cornerColumn < 2; cornerColumn++) {
            int tanSign = (cornerColumn == 0) ? -1 : 1;
            int biTanSign = (cornerRow == 0) ? -1 : 1;

            bool tanSideSolid = readVoxel(uvec3(airVoxel + tanStep * tanSign), texel, texel_coord);
            bool biTanSideSolid = readVoxel(uvec3(airVoxel + biTanStep * biTanSign), texel, texel_coord);
            bool cornerSolid = readVoxel(uvec3(airVoxel + tanStep * tanSign + biTanStep * biTanSign), texel, texel_coord);

            cornerAO[cornerRow * 2 + cornerColumn] = vertexAO(tanSideSolid, biTanSideSolid, cornerSolid);
        }

    return mix(
        mix(
            cornerAO[0], cornerAO[1], tanFrac
        ),
        mix(
            cornerAO[2], cornerAO[3], tanFrac
        ),
        biTanFrac
    );
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(outputImage);
    if (any(greaterThanEqual(pixel, outputSize))) return;

    vec3 hitPosition = imageLoad(hit_pos, pixel).rgb;
    vec3 albedo = imageLoad(albedo, pixel).rgb;
    vec3 normal = imageLoad(normals, pixel).rgb;
    float shadow = imageLoad(shadows, pixel).r;

    vec3 directionToSun = normalize(params.sun.position - hitPosition);
    float normalDotSun = max(dot(normal, directionToSun), 0.0);
    vec3 sunLight = params.sun.color * params.sun.intensity * normalDotSun * shadow;


    vec3 lightMapUVW = (hitPosition + normal * 0.5 - vec3(params.lightVolumeMin)) / params.volumeSize;
    vec3 localLight = texture(lightMap, lightMapUVW).rgb * params.localStrength;

    float AO = mix(
        1.0,
        voxelAO(hitPosition, normal),
        params.aoStrength
    );

    vec3 ambientLight = params.skyColor * AO;

    vec3 outColor = albedo * (sunLight + localLight * AO + ambientLight);
    imageStore(outputImage, pixel, vec4(outColor, 1.0));
}
 
