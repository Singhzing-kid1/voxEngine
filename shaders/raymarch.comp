#version 460
#extension GL_GOOGLE_include_directive : require

#include "types.glsl"


const uint DEFAULT = 0; 
const uint COORD = 1;
const uint STEPS = 2;
const uint NORMAL = 3;
const uint UV = 4;
const uint DEPTH = 5;
const uint LOD_BIAS = 6;

const float BIOME_BALD          = 0.0;
const float BIOME_HEATH_BALD    = 1.0;
const float BIOME_SPRUCE_FIR    = 2.0;
const float BIOME_FALL_RIDGE    = 3.0;
const float BIOME_HEMLOCK_HOLLOW = 4.0;  // was HEMLOCK_GORGE + RHODO_HOLLOW
const float BIOME_BLUE_RIDGE    = 5.0;
const float BIOME_FROSTED_PEAK  = 6.0;
const float BIOME_WETLAND       = 7.0;  // was MARSH + FLOODPLAIN
const float BIOME_HAYFIELD      = 8.0;  // was HAYFIELD + OLD_FIELD
const float BIOME_SHALE_BARREN  = 9.0;  // was SHALE_BARREN + OUTCROP
const float BIOME_PIEDMONT      = 10.0;
const float BIOME_COVE_FOREST   = 11.0; // was COVE_FOREST + TULIP_POPLAR
const float BIOME_HARDWOOD      = 12.0; // was HARDWOOD + SUGAR_MAPLE
const float BIOME_PINE_OAK      = 13.0;
const float BIOME_LAUREL        = 14.0;
const float BIOME_BIRCH_BEECH   = 15.0;
const float BIOME_SUMAC_SCRUB   = 16.0;

const vec3 LIGHT_POS = vec3(2000.0, 3000.0, 1000.0);

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant) uniform PushConstants {
    mat4 pixelToRay;
    uvec3 voxel_resolution; 
    uint render_mode;
    float max_ray_length;
    float max_height;
    float lod_bias;
    GlobalLight sun;
} pc;

layout(set = 0, binding = 0, rgba8) writeonly uniform image2D albedo;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D normals;
layout(set = 0, binding = 2, r8) writeonly uniform image2D shadows;
layout(set = 0, binding = 3, rgba32f) writeonly uniform image2D hit_pos;

layout(set = 1, binding = 0, rgba32ui) readonly uniform uimage3D voxelImage;
layout(set = 1, binding = 1, rgba8) readonly uniform image2D biomeImage;

layout(set = 2, binding = 0) uniform sampler albedo_sampler;
layout(set = 2, binding = 1) uniform texture2DArray albedo_textures;
layout(set = 2, binding = 2) uniform sampler normals_sampler;
layout(set = 2, binding = 3) uniform texture2DArray normals_textures;

#include "common.glsl"

vec3 rayDiff(vec3 u, vec3 a, uint axis, float t) {
    float denom = u[axis] + a[axis];
    denom = (denom >= 0.0) ? max(denom, 1e-6) : min(denom, -1e-6);
    return (t / denom) * (a * u[axis] - u * a[axis]);
}

vec2 faceUV(vec3 v, uint axis) {
    if (axis == 0) return v.yz;
    if (axis == 1) return v.xz;
    return v.xy;
}

float biome_index(float temperature, float height, float moisture) {
    // --- High elevation overrides ---
    if (height > 0.70) {
        return BIOME_FROSTED_PEAK;
    }
    if (height > 0.65) {
        if (temperature < 0.40 && moisture > 0.40) {
            return BIOME_SPRUCE_FIR;
        }
        return BIOME_BLUE_RIDGE;
    }

    // --- Cold ---
    if (temperature < 0.25) {
        return BIOME_HEATH_BALD;
    }

    // --- Hot ---
    if (temperature > 0.65) {
        if (moisture < 0.25) {
            return BIOME_BALD;
        } else if (moisture < 0.55) {
            return BIOME_FALL_RIDGE;
        } else {
            return BIOME_HEMLOCK_HOLLOW;
        }
    }

    // --- Moderate temperature ---

    // Valleys
    if (height < 0.42) {
        if (moisture > 0.44) return BIOME_WETLAND;
        if (moisture > 0.36) return BIOME_HAYFIELD;
        return BIOME_SHALE_BARREN;
    }

    // Lowlands
    if (height < 0.50) {
        if (moisture > 0.52) return BIOME_HEMLOCK_HOLLOW;
        if (moisture > 0.44) return BIOME_COVE_FOREST;
        if (moisture > 0.36) return BIOME_PIEDMONT;
        return BIOME_HAYFIELD;
    }

    // Foothills
    if (height < 0.58) {
        if (moisture > 0.52) return BIOME_COVE_FOREST;
        if (moisture > 0.36) return BIOME_HARDWOOD;
        return BIOME_PINE_OAK;
    }

    // Upper slopes
    if (moisture > 0.52) return BIOME_LAUREL;
    if (moisture > 0.44) return BIOME_BIRCH_BEECH;
    if (moisture > 0.36) return BIOME_SUMAC_SCRUB;
    return BIOME_SHALE_BARREN;
}

// https://www.shadertoy.com/view/WlfXRN
vec3 inferno(float t) {
    const vec3 c0 = vec3(0.0002189403691192265, 0.001651004631001012, -0.01948089843709184);
    const vec3 c1 = vec3(0.1065134194856116, 0.5639564367884091, 3.932712388889277);
    const vec3 c2 = vec3(11.60249308247187, -3.972853965665698, -15.9423941062914);
    const vec3 c3 = vec3(-41.70399613139459, 17.43639888205313, 44.35414519872813);
    const vec3 c4 = vec3(77.162935699427, -33.40235894210092, -81.80730925738993);
    const vec3 c5 = vec3(-71.31942824499214, 32.62606426397723, 73.20951985803202);
    const vec3 c6 = vec3(25.13112622477341, -12.24266895238567, -23.07032500287172);
    return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
}

vec3 stepsToInferno(uint steps, uint start, uint end) {
    float t = float(int(steps - start)) / float(end - start);
    return inferno(clamp(t, 0.0, 1.0));
}

vec3 applyFog(vec3 baseColor, float depth) {
    float fog_start = pc.max_ray_length * 0.40;
    float fog_amount = smoothstep(fog_start, pc.max_ray_length, depth);
    vec3 fog_color = vec3(0.07, 0.09, 0.13);
    return mix(baseColor, fog_color, fog_amount);
}

vec3 applyFogHeightLimited(vec3 baseColor, float depth, float pointY) {
    if (pointY > pc.max_height) return baseColor; 
    return applyFog(baseColor, depth);
}

const float FLT_MAX = 3.4028235e+38;

const float SHADOW_MAX_DIST = 256.0; // voxels; tune to taste
const float SHADOW_EPS      = 0.002; // nudge past a boundary so floor() lands in the next cell
const ivec3 BRICK           = ivec3(4, 4, 8);

// Returns true if any solid voxel lies between `origin` and `origin + dir * max_dist`.
bool shadowRay(vec3 origin, vec3 dir, float max_dist) {
    // --- Shorten the ray as much as possible ---
    max_dist = min(max_dist, SHADOW_MAX_DIST);

    // Heading upward: nothing can block the ray once it is above the tallest voxel
    if (dir.y > 1e-6) {
        max_dist = min(max_dist, (pc.max_height - origin.y) / dir.y);
    }
    if (max_dist <= 0.0) return false;

    // Zero components are treated as positive so inv_dir never flips to -infinity
    vec3 pos_dir = vec3(greaterThanEqual(dir, vec3(0.0)));          // 1 where dir >= 0, else 0
    vec3 inv_dir = clamp(1.0 / dir, vec3(-FLT_MAX), vec3(FLT_MAX));

    ivec3 res = ivec3(pc.voxel_resolution);

    // A DDA ray crosses at most ~sqrt(3) cells per unit of distance; empty-brick skips only reduce this
    uint max_steps = uint(max_dist * 1.75) + 3u;

    ivec3 texel_coord = ivec3(-1);
    uvec4 texel       = uvec4(0);

    float t = 0.0;

    for (uint i = 0u; i < max_steps; i++) {
        if (t > max_dist) return false;

        vec3  p      = origin + dir * t;
        ivec3 icoord = ivec3(floor(p));

        // Left the volume: nothing else can block the light
        if (any(lessThan(icoord, ivec3(0))) || any(greaterThanEqual(icoord, res))) return false;

        if (readVoxel(uvec3(icoord), texel, texel_coord)) return true;

        // `texel` now holds this voxel's brick. If the whole brick is empty, skip to its exit;
        // otherwise advance to the exit of just this voxel.
        ivec3 cell_min, cell_size;
        if (all(equal(texel, uvec4(0u)))) {
            cell_size = BRICK;
            cell_min  = (icoord / BRICK) * BRICK;
        } else {
            cell_size = ivec3(1);
            cell_min  = icoord;
        }

        vec3 exit_plane = vec3(cell_min) + vec3(cell_size) * pos_dir;
        vec3 t_exit     = (exit_plane - origin) * inv_dir;
        t = min(t_exit.x, min(t_exit.y, t_exit.z)) + SHADOW_EPS;
    }
    return false;
}

bool traversal(vec3 origin, vec3 dir, out vec3 color, out vec3 normals, out vec3 shadow, out vec3 hit_position, inout uint steps) {

    if (length(dir) < 1e-6) return false;

    float playerY = origin.y;
    vec3 res = vec3(pc.voxel_resolution);  // (4000, 4000, 2000)

    vec3 inv_dir = 1.0 / dir;
    vec3 sgn_dir = sign(dir);
    inv_dir = clamp(inv_dir, vec3(-FLT_MAX), vec3(FLT_MAX));

    vec3 t1 = -origin * inv_dir;
    vec3 t2 = (res - origin) * inv_dir;

    vec3 tmins = min(t1, t2);
    vec3 tmaxs = max(t1, t2);

    float tmin = 0.0;
    float tmax = FLT_MAX;
    for (int i = 0; i < 3; i++) {
        tmin = max(tmin, tmins[i]);
        tmax = min(tmax, tmaxs[i]);
    }

    tmax = min(tmax, pc.max_ray_length);

    if (tmin > tmax) {
        color = vec3(0.0);
        normals = vec3(0.0);
        shadow = vec3(1.0);
        hit_position = vec3(0.0);
        if (pc.render_mode == DEFAULT) {
            float missY = origin.y + dir.y * tmax;
            color = applyFogHeightLimited(vec3(0.0), tmax, missY);
        }
        return false;
    }

    uint stepped_axis;
    if (tmins.x > tmins.y) {
        if (tmins.x > tmins.z) stepped_axis = 0;
        else                   stepped_axis = 2;
    } else {
        if (tmins.y > tmins.z) stepped_axis = 1;
        else                   stepped_axis = 2;
    }

    origin += dir * tmin;

    ivec3 icoord = ivec3(clamp(floor(origin), vec3(0), res - 1.0));
    ivec3 istep  = ivec3(sgn_dir);
    vec3  t      = (vec3(icoord) + 0.5 * (1.0 + sgn_dir) - origin) * inv_dir;
    vec3  delta  = inv_dir * sgn_dir;

    // Max steps = longest possible diagonal across the volume
    uint max_steps = pc.voxel_resolution.x + pc.voxel_resolution.y + pc.voxel_resolution.z + 10u;

    ivec3 texel_coord = ivec3(-1);
    uvec4 texel       = uvec4(0);

    bool instantHit = readVoxel(uvec3(icoord), texel, texel_coord);
    if (!instantHit)
    while (true) {
        steps++;
        if (steps > max_steps) {
            color = vec3(0.0);
            normals = vec3(0.0);
            shadow = vec3(1.0);
            hit_position = vec3(0.0);
            if (pc.render_mode == DEFAULT) color = applyFog(vec3(0.0), pc.max_ray_length);
            return false;
        }

        if (t.x < t.y) {
            if (t.x < t.z) {
                icoord.x += istep.x;
                t.x += delta.x;
                stepped_axis = 0;
            } else {
                icoord.z += istep.z;
                t.z += delta.z;
                stepped_axis = 2;
            }
        } else {
            if (t.y < t.z) {
                icoord.y += istep.y;
                t.y += delta.y;
                stepped_axis = 1;
            } else {
                icoord.z += istep.z;
                t.z += delta.z;
                stepped_axis = 2;
            }
        }

        if (min(t.x, min(t.y, t.z)) - min(delta.x, min(delta.y, delta.z)) > tmax) {
            color = vec3(0.0);
            normals = vec3(0.0);
            shadow = vec3(1.0);
            hit_position = vec3(0.0);
            if (pc.render_mode == DEFAULT) {
                float missY = origin.y + dir.y * tmax;
                color = applyFogHeightLimited(vec3(0.0), tmax, missY);
            }
            return false;
        }

        if (any(lessThan(icoord, ivec3(0))) ||
            any(greaterThanEqual(icoord, ivec3(pc.voxel_resolution)))) {
            color = vec3(0.0);
            normals = vec3(0.0);
            shadow = vec3(1.0);
            hit_position = vec3(0.0);
            if (pc.render_mode == DEFAULT) {
                float missY = origin.y + dir.y * tmax;
                color = applyFogHeightLimited(vec3(0.0), tmax, missY);
            }
            return false;
        }

        if (readVoxel(uvec3(icoord), texel, texel_coord))
            break;
    }

    vec3 mask = vec3(0);
    mask[stepped_axis] = 1.0;
    float t_inside = dot(t, mask) - dot(delta, mask);

    switch (pc.render_mode) {
        case DEFAULT: {
            vec3 N = -mask * sgn_dir;

            vec3 T = mask.x * vec3(0, 0, 1) + (mask.y + mask.z) * vec3(1, 0, 0);
            vec3 B = mask.x * vec3(0, 1, 0) + mask.y * vec3(0, 0, 1) + mask.z * vec3(0, 1, 0);

            vec4 biome = imageLoad(biomeImage, ivec2(icoord.x, icoord.z));

            float texture_index = biome_index(biome.r, biome.g, biome.b);

            vec3 hit = origin + dir * t_inside;
            vec3 local_hit = hit - vec3(icoord);
            vec2 uv;
            if      (stepped_axis == 0) uv = local_hit.yz;
            else if (stepped_axis == 1) uv = local_hit.xz;
            else                        uv = local_hit.xy;

            float depth = (tmin + t_inside) * length(dir);
            
            vec3 u  = mat3(pc.pixelToRay) * vec3(vec2(gl_GlobalInvocationID.xy) + 0.5, 1.0);
            float t_ray = depth / length(u);

            vec2 ddx_uv = faceUV(rayDiff(u, pc.pixelToRay[0].xyz, stepped_axis, t_ray), stepped_axis);
            vec2 ddy_uv = faceUV(rayDiff(u, pc.pixelToRay[1].xyz, stepped_axis, t_ray), stepped_axis);

            float bias = exp2(pc.lod_bias);
            ddx_uv = clamp(ddx_uv * bias, vec2(-2.0), vec2(2.0));
            ddy_uv = clamp(ddy_uv * bias, vec2(-2.0), vec2(2.0));

            vec3 start = hit + N * 0.01;

            vec3  to_light = pc.sun.position - start;
            float dist     = length(to_light);
            vec3  L        = to_light / dist;

            // Faces pointing away from the light are shadowed; otherwise trace toward it
            bool blocked = dot(N, L) <= 0.0 || shadowRay(start, L, dist);

            shadow = (pc.sun.intensity == 0.0) ? vec3(1.0) : vec3(blocked ? 0.0 : 1.0);


            color = textureGrad(sampler2DArray(albedo_textures, albedo_sampler), vec3(uv, texture_index), ddx_uv, ddy_uv).rgb;
            color = applyFogHeightLimited(color, depth, icoord.y);

            normals = textureGrad(sampler2DArray(normals_textures, normals_sampler), vec3(uv, 0.0), ddx_uv, ddy_uv).rgb;
			normals = normals * 2.0 - 1.0;
            normals = normalize(T * normals.r + B * normals.g + N * normals.b);

            hit_position = origin + dir * t_inside;

            break;
        }

        case COORD: {
            // Normalize each axis by its own resolution
            color = vec3(icoord) / (res - 1.0);
            break;
        }

        case NORMAL: {
            vec3 normal = -mask * sgn_dir;
            color = max(normal.xyz, 0.0) - min(normal.yxz + normal.zyx, 0.0);
            break;
        }

        case UV: {
            vec3 hit = origin + dir * t_inside;
            vec3 local_hit = hit - vec3(icoord);
            vec2 uv;
            if      (stepped_axis == 0) uv = local_hit.yz;
            else if (stepped_axis == 1) uv = local_hit.xz;
            else                        uv = local_hit.xy;
            color = vec3(uv, 0.0);
            break;
        }
        
        case DEPTH: {
            vec3 N = -mask * sgn_dir;
            vec3 hit = origin + dir * t_inside;

            // Nudge off the surface so the ray starts in the empty voxel, not the one we hit
            vec3 start = hit + N * 0.01;

            vec3  to_light = pc.sun.position - start;
            float dist     = length(to_light);
            vec3  L        = to_light / dist;

            // Faces pointing away from the light are shadowed; otherwise trace toward it
            bool blocked = dot(N, L) <= 0.0 || shadowRay(start, L, dist);

            color = vec3(blocked ? 0.0 : 1.0);
            break;
        }

        case LOD_BIAS: {
            vec3 hit = origin + dir * t_inside;
            vec3 local_hit = hit - vec3(icoord);
            vec2 uv;
            if      (stepped_axis == 0) uv = local_hit.yz;
            else if (stepped_axis == 1) uv = local_hit.xz;
            else                        uv = local_hit.xy;

            float depth = (tmin + t_inside) * length(dir);
            
            vec3 u  = mat3(pc.pixelToRay) * vec3(vec2(gl_GlobalInvocationID.xy) + 0.5, 1.0);
            float t_ray = depth / length(u);

            vec2 ddx_uv = faceUV(rayDiff(u, pc.pixelToRay[0].xyz, stepped_axis, t_ray), stepped_axis);
            vec2 ddy_uv = faceUV(rayDiff(u, pc.pixelToRay[1].xyz, stepped_axis, t_ray), stepped_axis);

            float bias = exp2(pc.lod_bias);
            ddx_uv = clamp(ddx_uv * bias, vec2(-2.0), vec2(2.0));
            ddy_uv = clamp(ddy_uv * bias, vec2(-2.0), vec2(2.0));

            color = vec3(length(ddx_uv) * 64.0);

            break;
        }
    }
    return true;
}

void main() {
    ivec2 pixelCoord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(albedo);
    if (any(greaterThanEqual(pixelCoord, imgSize))) return;

    vec3 o = pc.pixelToRay[3].xyz;
    vec3 d = normalize(mat3(pc.pixelToRay) * vec3(pixelCoord, 1));

    vec3 color;
    vec3 normal;
    vec3 shadow;
    vec3 hit_position;
    uint steps = 0;
    bool hit = traversal(o, d, color, normal, shadow, hit_position, steps);

    if (pc.render_mode == STEPS) {
        uint max_steps = pc.voxel_resolution.x + pc.voxel_resolution.y + pc.voxel_resolution.z;
        color = stepsToInferno(steps, 0u, max_steps);
        imageStore(albedo, pixelCoord, vec4(color, 1));
    } else if (hit || pc.render_mode == DEFAULT) {
        imageStore(albedo, pixelCoord, vec4(color, 1));
        imageStore(normals, pixelCoord, vec4(normal, 1));
        imageStore(shadows, pixelCoord, vec4(shadow, 1));
        imageStore(hit_pos, pixelCoord, vec4(hit_position, hit));
    }
}
