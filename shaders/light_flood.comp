#version 460
#extension GL_GOOGLE_include_directive : require

#include "types.glsl"
// LocalLight struct ^^

layout(local_size_x = 4, local_size_y = 4, local_size_z = 8) in;

layout(set = 0, binding = 0, rgba32ui) readonly uniform uimage3D voxelImage;

layout(set = 1, binding = 0, rgba16f) readonly uniform image3D lightMapSource;
layout(set = 1, binding = 1, rgba16f) writeonly uniform image3D lightMapDst;

layout(set = 2, binding = 0, std430) readonly buffer Lights {
	LocalLight lights[];
};

layout(push_constant) uniform Params {
	ivec3 lightVolumeMin;
	uint localLightCount;
	float falloffPerVoxel;
} params;

#include "common.glsl"

void main() {
	ivec3 cell = ivec3(gl_GlobalInvocationID);
	ivec3 volumeSize = imageSize(lightMapDst);

	if (any(greaterThanEqual(cell, volumeSize))) return;

	ivec3 voxel = params.lightVolumeMin + cell;

	ivec3 texel_coord = ivec3(-1);
    uvec4 texel       = uvec4(0);

	bool outsideWorld = any(lessThan(voxel, ivec3(0))) || any(greaterThanEqual(voxel, imageSize(voxelImage) * ivec3(4, 4, 8)));

	if(outsideWorld || readVoxel(uvec3(voxel), texel, texel_coord)) {
		imageStore(lightMapDst, cell, vec4(0.0));
		return;
	}

	vec3 brightestLight = vec3(0.0);

	for (uint lightIndex = 0u; lightIndex < params.localLightCount; lightIndex++) {
		if (ivec3(floor(lights[lightIndex].posRadius.xyz)) == voxel) {
			brightestLight = max(brightestLight, lights[lightIndex].colorIntensity.rgb * lights[lightIndex].colorIntensity.a);
		}
	}
	

	for (int offsetZ = -1; offsetZ <= 1; offsetZ++)
		for (int offsetY = -1; offsetY <= 1; offsetY++)
			for (int offsetX = -1; offsetX <= 1; offsetX++) {
				if (offsetX == 0 && offsetY == 0 && offsetZ == 0) continue;
				ivec3 neighborOffset = ivec3(offsetX, offsetY, offsetZ);
				ivec3 neighborCell = cell + neighborOffset;
				if (any(lessThan(neighborCell, ivec3(0))) || any(greaterThanEqual(neighborCell, volumeSize))) continue;

				float attenuation = pow(params.falloffPerVoxel, length(vec3(neighborOffset)));
				vec3 neighborLight = imageLoad(lightMapSource, neighborCell).rgb * attenuation;
				brightestLight = max(brightestLight, neighborLight);
			}

	imageStore(lightMapDst, cell, vec4(brightestLight, 0.0));
}




